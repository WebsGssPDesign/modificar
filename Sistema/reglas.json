{
  "version": 1,
  "_ayuda": "Fuente unica de decisiones. Precedencia: defaults < este archivo < variables de entorno. La env de 'a.b_c' es A_B_C.",
  "rutas": {
    "_ayuda": "Alias de compatibilidad: MEMORIA_BOVEDA, MEMORIA_NOTAS, MEMORIA_SKILLS",
    "boveda": "F:\\automatizaciones\\homeLab",
    "notas": "LLM-Memoria",
    "diario": "Diario",
    "skills": "skills",
    "papelera": "Sistema/papelera",
    "descartados": "_descartados"
  },
  "llm": {
    "_alias": "LLM_MODEL, LMSTUDIO_URL",
    "endpoint": "http://127.0.0.1:1234/v1",
    "modelo_chat": "",
    "modelo_embed": "",
    "timeout": 900,
    "reintentos": 3,
    "pausa_reintento": 5.0,
    "temperature": 0.2,
    "max_tokens": 1500
  },
  "memoria": {
    "min_sim": 0.35,
    "pool": 30,
    "chunk_chars": 1200,
    "overlap": 150,
    "batch": 32,
    "lock_vencimiento": 900,
    "max_sync_segundos": 25,
    "max_caracteres_resultado": 800,
    "max_caracteres_total": 4000,
    "timeout": 120
  },
  "aprender": {
    "max_chars": 6000,
    "max_tokens": 1500,
    "temperature": 0.2,
    "timeout": 900,
    "max_intentos": 3,
    "pausa": 0.5,
    "max_minutos": 480,
    "sin_conexion_seg": 1800,
    "excluir": [
      "LLM-Memoria", "Diario", "memoria_vectorial", ".memoria", "assets",
      ".venv", "node_modules", ".git", ".obsidian", ".trash", "papelera"
    ],
    "extensiones": [".md", ".txt"]
  },
  "skills": {
    "max_por_corrida": 8,
    "min_material": 3,
    "rondas_vacias": 2,
    "reintentar_dias": 14,
    "max_tokens": 600,
    "secciones": ["## Proposito", "## Cuando usarla", "## Pasos", "## Reglas", "## Errores comunes", "## Fuentes"]
  },
  "web": {
    "fuentes_api": ["wikipedia", "arxiv", "github"],
    "fuentes_html": ["react.dev", "nextjs.org", "python.org", "docs.n8n.io", "learn.microsoft.com", "nodejs.org", "sqlite.org", "obsidian.md"],
    "respetar_robots": true,
    "min_texto": 600,
    "max_texto": 6000,
    "max_bytes": 2000000,
    "pausa_ciclo_seg": 300,
    "min_relevancia": 0.45,
    "min_prioridad": 0.25,
    "enfriamiento_min": 15,
    "fallos_para_aislar": 5,
    "horas_aislamiento": 24,
    "dominios_permitidos": [
      "react.dev", "nextjs.org", "mongodb.com", "python.org", "developer.mozilla.org",
      "wikipedia.org", "arxiv.org", "github.com", "docs.n8n.io", "learn.microsoft.com",
      "nodejs.org", "npmjs.com", "sqlite.org", "obsidian.md", "lmstudio.ai",
      "unsloth.ai", "huggingface.co", "stackoverflow.com", "json-schema.org",
      "ollama.com", "openwebui.com", "readthedocs.io", "raw.githubusercontent.com",
      "github.blog", "n8n.io", "docs.python.org", "w3schools.com",
      "news.ycombinator.com", "reddit.com", "phoronix.com"
    ],
    "dominios_prohibidos": ["pinterest.com", "quora.com"],
    "limites": { "max_por_hora": 30, "max_por_dia": 200, "max_bytes_dia": 20000000 }
  },
  "indice": {
    "extensiones": [".md", ".txt", ".py", ".js", ".ts", ".jsx", ".tsx", ".json", ".yml", ".yaml", ".toml", ".ini", ".cfg", ".ps1", ".bat", ".sh", ".sql", ".css", ".html"],
    "ignorar_archivos": [
      "Progreso.md", "Tablero.md", "AprendidoHoy.md", "AprendidoSemana.md",
      "Cola.md", "heartbeat.json", "incidencias.json", "metricas.jsonl",
      "auditoria.jsonl", "eventos.jsonl", "descartes.jsonl"
    ],
    "ignorar_dirs": ["LLM-Memoria/MOC", "LLM-Memoria/Revision", "memoria_vectorial", ".memoria", ".venv", "node_modules", ".git", ".obsidian", ".trash", "_descartados", "Sistema/papelera", "assets"],
    "max_bytes_archivo": 300000,
    "watch_segundos": 20
  },
  "guardian": {
    "activo": true,
    "modo": "observacion",
    "vigilar": ["lmstudio", "sqlite", "indice", "heartbeat", "incidencias", "locks", "logs", "deps", "disco"],
    "intervalo_segundos": 60,
    "cooldown_min": 10,
    "max_reparaciones_hora": 6,
    "permitir_pip": true,
    "permitir_reiniciar_lmstudio": true,
    "permitir_escribir_codigo": false,
    "verificar_integridad_min": 60,
    "backup_dias": 7,
    "heartbeat_vencido_seg": 300,
    "guardian_vencido_seg": 300,
    "espacio_minimo_gb": 5,
    "log_max_mb": 5,
    "deps_verificar": true,
    "cooldown_incidencia_min": 15,
    "reparaciones_permitidas": ["lock_obsoleto", "log_rotado", "servidor_lmstudio", "pip_faltantes", "indice_corrupto", "backup", "heartbeat_colgado"]
  },
  "eventos": { "activo": true, "webhook": "", "timeout": 5 },
  "prompts": { "dir": "prompts", "usar_disco": true },
  "tablero": {
    "dias_grafico": 30,
    "min_notas_moc": 3,
    "repaso_dias": [1, 3, 7, 21, 60],
    "max_listado": 25
  },
  "confianza": {
    "por_fuente": {
      "oficial": "alta", "arxiv": "alta", "local": "alta",
      "wikipedia": "media", "github": "media", "sistema": "media",
      "blog": "baja", "stackoverflow": "media"
    }
  },
  "agente": { "idioma": "es", "inferir_stack": true, "avisar_datos_no_instrucciones": true }
}
